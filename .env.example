# Local Vite server only. Copy settings into ignored .env.local; never use VITE_ prefixes.
GEMINI_API_KEY=
# Optional server-only model. Omit to use this default; restart Vite after changing.
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional trusted server/CLI access. Separate random 32–256 character credential, never bundled in the UI.
AI_DRAFT_ACCESS_TOKEN=
# Reviewer sign-in: random 20–128 characters, 10 distinct characters, at least 3 character classes.
BIAI_REVIEWER_PASSWORD=
# Independent random 32-byte secret encoded as exactly 64 hexadecimal characters.
BIAI_SESSION_SECRET=
